# Copy to ~/.config/times-gate-dashboard/env (outside the repo) and fill in.
DIVOOM_IP=192.168.1.50          # the lamp's LAN address (Divoom app → device settings, or your router)
DIVOOM_TOKEN=000000             # the lamp's LocalToken; requests without it get "DeviceToken is err"
PYTHON=python3                  # an interpreter with Pillow installed (use a full path for launchd)
# Optional: the Cloudflare collector. Leave empty to run with local tiles only (clock + Claude).
COLLECTOR_URL=                  # e.g. https://times-gate-collector.<you>.workers.dev
PULL_TOKEN=                     # same value as the Worker secret PULL_TOKEN
